# Copie para .env (que NÃO vai para o Git) e ajuste. Todas as variáveis são opcionais.

# Cache (segundos)
CACHE_TTL_SECONDS=900
CACHE_PARTIAL_TTL_SECONDS=60
CACHE_MAX_STALE_SECONDS=86400
CACHE_FAILURE_COOLDOWN_SECONDS=15

# Cliente HTTP das fontes oficiais
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
CAMARA_CONCURRENCY=8

# API
RATE_LIMIT=120/minute
ENABLE_DOCS=true
# Quantos proxies confiáveis ficam na frente da API (0 = nenhum; ignora X-Forwarded-For)
TRUSTED_PROXY_HOPS=0
# Lista JSON. Vazio = nenhuma origem de navegador autorizada (o Streamlit chama a API pelo servidor).
# CORS_ORIGINS=["https://meusite.example"]

# Frontend
API_BASE_URL=http://localhost:8000
